# Optional. Leave unset to run in demo mode (signups log to the server console).
#
# Formspree: https://formspree.io/f/xxxxxxxx
# Also works with a Google Apps Script web app, Make, Zapier, or Resend webhook.
WAITLIST_WEBHOOK_URL=

# Optional. If set, each signup is stored as a private JSON object in Vercel Blob.
# Create a store in the Vercel dashboard, then copy BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
